APP_ENV=local
DATABASE_URL=postgresql+psycopg://vendor:vendor@db:5432/vendor
ADMIN_TOKEN=change-me
TOKEN_SECRET=change-me
TOKEN_TTL_HOURS=168
PUBLIC_BASE_URL=http://localhost:8000
# Set AI_MODE=live only after adding an OpenAI API key to your local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MODE=fake
# Keep document labels deterministic until you intentionally enable OpenAI document routing.
DOCUMENT_AI_MODE=fake
MAIL_MODE=console
MAIL_FROM=
OWNER_ALERT_EMAIL=
SOURCING_MANAGER_EMAIL=sourcing@example.test
MASTER_DATA_EMAIL=master-data@example.test
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
STORAGE_MODE=local
LOCAL_STORAGE_DIR=/app/data/documents
S3_BUCKET=
AWS_REGION=
INBOX_MODE=manual
GMAIL_LABEL=vendor-requests
# Required only when INBOX_MODE=gmail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SCHEDULER_ENABLED=false
TZ=Asia/Dubai
